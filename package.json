{
  "name": "la-theme",
  "version": "1.0.0",
  "description": "Lucky Apps 主题插件：内置多套配色方案，跟随亮色 / 暗色模式",
  "keywords": [
    "cordis",
    "lucky-app"
  ],
  "private": true,
  "type": "module",
  "main": "lib/node.js",
  "exports": {
    ".": "./lib/node.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "element-plus": "^2.14.7",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  },
  "la": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js"
    },
    "kind": "feature"
  }
}
